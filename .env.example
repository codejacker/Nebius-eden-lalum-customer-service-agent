# === Required ===
# Get this from https://studio.nebius.ai → API Keys
NEBIUS_API_KEY=your-nebius-api-key-here

# === LangSmith Studio (strongly recommended for debugging) ===
# Free account at https://smith.langchain.com
# Without this the agent still runs — you just won't see the visual debugger
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=customer-service-agent
